{
	"name": "close-by",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"packages:upgrade": "ncu -u",
		"cf:typegen": "wrangler types",
		"migrations:remote": "wrangler d1 migrations apply close-by --remote",
		"migrations:local": "wrangler d1 migrations apply close-by --local",
		"migrations:generate": "drizzle-kit generate",
		"predev": "pnpm run cf:typegen && pnpm run routes:generate && pnpm run migrations:local",
		"dev": "rsbuild",
		"routes:generate": "tsr generate",
		"build": "rsbuild build",
		"preview": "pnpm run build && wrangler dev",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "pnpm run migrations:remote && pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/router-plugin": "^1.168.47",
		"drizzle-orm": "^0.45.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-server-dom-rspack": "^0.0.2",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@rsbuild/core": "^2.2.14",
		"@rsbuild/plugin-react": "^2.1.1",
		"@rsbuild/plugin-tailwindcss": "^2.0.3",
		"@tanstack/router-cli": "^1.167.45",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.11",
		"miniflare": "^4.20260730.0",
		"npm-check-updates": "^22.2.9",
		"typescript": "^6.0.3",
		"wrangler": "^4.151.3"
	}
}
